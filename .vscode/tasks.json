{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "dev: api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src\\Brewprint.Api",
        "--no-launch-profile",
        "--urls",
        "http://127.0.0.1:5080"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "dev",
      "dependsOn": ["dev: api", "dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
