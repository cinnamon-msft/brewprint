{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "dev: api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src\\Brewprint.Api",
        "--no-launch-profile",
        "--urls",
        "http://127.0.0.1:5080"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "dev",
      "dependsOn": ["dev: api", "dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "install: web",
      "type": "shell",
      "command": "npm",
      "args": ["ci"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "problemMatcher": []
    },
    {
      "label": "build: api",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Brewprint.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "build",
      "dependsOn": ["build: api", "build: web"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "test: api",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "Brewprint.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: web",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "problemMatcher": []
    },
    {
      "label": "test",
      "dependsOn": ["test: api", "test: web"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "install: chromium",
      "type": "shell",
      "command": "npm",
      "args": ["exec", "--", "playwright", "install", "chromium"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "problemMatcher": []
    },
    {
      "label": "test: e2e",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:e2e"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\Brewprint.Web"
      },
      "problemMatcher": []
    },
    {
      "label": "publish",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "src\\Brewprint.Api",
        "--configuration",
        "Release",
        "--output",
        "artifacts\\publish"
      ],
      "dependsOn": ["build: web"],
      "problemMatcher": "$msCompile"
    }
  ]
}
