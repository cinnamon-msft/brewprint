<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="RequireFrontendForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')"
           Text="Build the frontend first: npm --prefix src/Brewprint.Web run build" />
  </Target>

</Project>
