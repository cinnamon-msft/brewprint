{
  "meta": { "version": 3, "updatedBy": "Brewprint", "note": "Original vintage espresso-bar patterns; see DESIGN.md." },
  "components": [
    {
      "name": "RecipeTile",
      "note": "Name/volume choice beneath the single cup. Native aria-pressed button updates the recipe display, never overwrites the custom build.",
      "root": { "id": "recipe-tile", "el": "button", "layout": { "mode": "vertical", "gap": "3", "padding": "4" }, "appearance": { "background": "paper", "borderColor": "line", "radius": "sm" }, "children": ["{name}", "{servingMl} mL"] }
    },
    {
      "name": "Cup",
      "note": "One central original glass SVG, brass saucer, reflections and steam. Full-size ingredient callouts with brass leaders track every actual layer; names stay legible on narrow screens and amounts remain in text chips. Accurate fill, staggered pours and reduced-motion final state.",
      "root": { "id": "cup", "el": "svg", "appearance": { "color": "ink" } }
    },
    {
      "name": "IngredientTray",
      "note": "Each draggable ingredient includes a 44px native Add button using the same reducer action as drop.",
      "root": { "id": "tray", "el": "section", "layout": { "mode": "vertical", "gap": "3" }, "children": ["{label}", { "id": "add", "el": "button", "appearance": { "background": "accent", "color": "accentInk", "radius": "sm" }, "children": ["Add {label}"] }] }
    },
    {
      "name": "Builder",
      "note": "Build mode reuses the central 360mL cup. Recognize house recipes by ingredient proportions, showing the matched name/description and polite live status without changing contents. Undo/remove/reset and browsing preserve their existing behavior.",
      "root": { "id": "builder", "el": "section", "layout": { "mode": "vertical", "gap": "5", "padding": "5" }, "appearance": { "background": "surface", "radius": "md" } }
    },
    {
      "name": "ModeSwitch",
      "note": "House menu / Build your own. Two native aria-pressed buttons share one cup, not duplicate displays.",
      "root": { "id": "mode-switch", "el": "div", "attrs": { "role": "group", "aria-label": "Cup mode" }, "layout": { "mode": "horizontal", "gap": "1", "padding": "1" }, "appearance": { "background": "surface", "radius": "pill" }, "children": ["House menu", "Build your own"] }
    }
  ]
}
